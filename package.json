{
  "name": "ritty-ai-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "vercel-build": "node scripts/prepare-vercel.mjs",
    "start": "node dist/index.js",
    "start:discord-worker": "node dist/discordWorker.js",
    "check": "tsc --noEmit",
    "ingest:ritual-docs": "tsx src/scripts/ingestDocs.ts",
    "register:commands": "tsx src/scripts/registerCommands.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "openai": "^6.3.0",
    "pino": "^10.1.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
